        <!-- ===== Notes ===== -->
        <mxCell id="notes" value="&lt;b&gt;Key design decisions&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Row-Level Security&lt;/b&gt; enforces RBAC in the database — an aide physically cannot read family financials.&lt;br&gt;• &lt;b&gt;ACID transactions&lt;/b&gt;: &quot;give a med&quot; logs the event, decrements supply &amp;amp; writes the timeline atomically.&lt;br&gt;• &lt;b&gt;Append-only audit log&lt;/b&gt; = medical-grade accountability + family trust.&lt;br&gt;• &lt;b&gt;pgvector&lt;/b&gt; powers semantic recall &amp;amp; AI features inside the same DB.&lt;br&gt;• &lt;b&gt;Serverless v2&lt;/b&gt; scales with load (toward zero when idle) — cost-optimized &amp;amp; well-architected." style="text;html=1;whiteSpace=wrap;strokeColor=#D5DBDB;fillColor=#FBFBFB;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="700" y="685" width="520" height="120" as="geometry" />
        </mxCell>

