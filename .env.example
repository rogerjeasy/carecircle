# ---------------------------------------------------------------------------
# CareCircle environment variables. Copy to `.env` (or `.env.local`) and fill in.
# NEVER commit the real .env — only this example file is tracked.
# ---------------------------------------------------------------------------

# ---- Database: Amazon Aurora PostgreSQL ----
# Two-role model (see SETUP.md):
#  - DATABASE_URL           -> the LEAST-PRIVILEGE app role (carecircle_app). The running
#                              app uses this, so Row-Level Security is ENFORCED. Demo needs it.
#  - MIGRATION_DATABASE_URL -> the admin/owner connection. Used by drizzle-kit and the seed
#                              script to create tables/policies/demo data. Bypasses RLS (admin).
# Aurora requires SSL (sslmode=require).
DATABASE_URL="postgresql://carecircle_app:PASSWORD@HOST:5432/carecircle?sslmode=require"
MIGRATION_DATABASE_URL="postgresql://ADMIN:PASSWORD@HOST:5432/carecircle?sslmode=require"

# ---- Auth.js (NextAuth v5) ----
# Generate a secret with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-random-secret"

# Optional in dev. In production set to your deployed URL (e.g. https://carecircle.vercel.app)
# AUTH_URL="http://localhost:3000"

# ---- Google OAuth (optional sign-in provider) ----
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# When set, the "Continue with Google" button lights up automatically (server-side gate).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Apple OAuth (optional — needs a paid Apple Developer account) ----
# AUTH_APPLE_ID = your Services ID (e.g. app.carecircle.web).
# AUTH_APPLE_SECRET = the ES256 client-secret JWT (regenerate every <=6 months).
# Redirect URI: http://localhost:3000/api/auth/callback/apple
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# ---- Social button visibility (client-side) ----
# These mirror whether the OAuth creds above are set. They only control whether the button
# RENDERS; the server action is the real guard. Google shows unless set to "false"; Apple is
# hidden unless set to "true".
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED="true"
NEXT_PUBLIC_AUTH_APPLE_ENABLED="false"

# ---- Platform super-admin ----
# Comma-separated emails allowed into the cross-tenant admin console at /admin. These users see
# data across ALL care circles, so keep the list tight. Email is read from the verified session.
PLATFORM_ADMIN_EMAILS="admin@carecircle.demo"

# ---- Email delivery — password-reset & invite links ----
# Provider for transactional email. One of: ses | smtp | resend | console.
#   ses     — Amazon SES (the architecture's choice). Needs AWS creds below + a VERIFIED
#             EMAIL_FROM identity, and your SES account out of the sandbox to email anyone.
#   smtp    — any SMTP server (e.g. Gmail). Emails ANYONE for free with no domain / no approval.
#             Gmail: enable 2-Step Verification, create an App Password at
#             https://myaccount.google.com/apppasswords, then set SMTP_* below.
#   resend  — Resend (https://resend.com, free tier). Needs RESEND_API_KEY.
#   console — log the email to the server console (zero setup; great for local dev).
# Leave EMAIL_PROVIDER unset to auto-pick: SMTP when SMTP_* are set, else SES when AWS creds + a
# non-resend.dev EMAIL_FROM are present, else Resend when RESEND_API_KEY is set, else console.
EMAIL_PROVIDER=""
RESEND_API_KEY=""
# SMTP (used when EMAIL_PROVIDER=smtp). For Gmail: host smtp.gmail.com, port 465, user = your
# Gmail address, pass = the 16-char App Password (no spaces).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# The "From" address. SES → a verified identity. SMTP/Gmail → your Gmail address. Resend → a
# verified Resend sender (sandbox: 'onboarding@resend.dev').
EMAIL_FROM="CareCircle <onboarding@resend.dev>"

# ---- AWS (Amazon SES email, SNS escalation alerts; later Bedrock for the AI Digest) ----
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# SNS topic for urgent escalation alerts (a logged fall, ER visit). If unset, alerts log to console.
# SNS_ESCALATIONS_TOPIC_ARN="arn:aws:sns:us-east-1:<acct>:carecircle-escalations"
